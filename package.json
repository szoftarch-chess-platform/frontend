{
  "name": "chess-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "theme:types": "chakra typegen src/theme/index.ts",
    "dev:fake": "vite --mode fake"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.108.2",
    "chess.js": "^1.4.0",
    "react": "^19.2.7",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.7",
    "react-router": "^8.5.2",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.38.0",
    "@eslint/js": "^9.25.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
